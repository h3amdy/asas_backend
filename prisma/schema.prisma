model App {
  id                  Int                  @id @default(autoincrement())
  uuid                String               @unique @default(uuid())
  code                String               @unique
  name                String
  description         String?
  appType             ManagedAppType       @map("app_type")
  packageName         String?              @map("package_name")
  bundleId            String?              @map("bundle_id")
  schoolId            Int?                 @map("school_id")
  platforms           AppPlatform[]        @default([ANDROID])
  status              ManagedAppStatus     @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  isDeleted           Boolean              @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at")
  school              School?              @relation(fields: [schoolId], references: [id])
  deviceInstallations DeviceInstallation[]
  releases            Release[]

  @@index([schoolId])
  @@map("apps")
}

model Release {
  id                          Int                       @id @default(autoincrement())
  uuid                        String                    @unique @default(uuid())
  appId                       Int                       @map("app_id")
  versionName                 String                    @map("version_name")
  versionCode                 Int                       @map("version_code")
  buildNumber                 Int                       @map("build_number")
  channel                     ReleaseChannel            @default(STABLE)
  status                      ReleaseStatus             @default(DRAFT)
  updatePolicy                UpdatePolicy              @default(OPTIONAL) @map("update_policy")
  minimumSupportedVersionCode Int?                      @map("minimum_supported_version_code")
  releaseNotesAr              String?                   @map("release_notes_ar")
  releaseNotesEn              String?                   @map("release_notes_en")
  checksum                    String?
  publishedAt                 DateTime?                 @map("published_at")
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")
  isDeleted                   Boolean                   @default(false) @map("is_deleted")
  deletedAt                   DateTime?                 @map("deleted_at")
  deviceInstallations         DeviceInstallation[]
  distributions               ReleaseDistribution[]
  app                         App                       @relation(fields: [appId], references: [id])
  schoolAssignments           SchoolReleaseAssignment[]

  @@unique([appId, versionCode], map: "releases_app_version_code_key")
  @@index([appId, status], map: "releases_app_status_idx")
  @@index([publishedAt])
  @@map("releases")
}

