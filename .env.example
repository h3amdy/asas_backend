# ═══════════════════════════════════════════════════════════════
# ⚙️  مثال ملف Environment — لا تضع أسرار حقيقية هنا
# ═══════════════════════════════════════════════════════════════
#
# انسخ هذا الملف إلى .env أو .env.staging وعدّل القيم:
#   cp .env.example .env
#
# القيم المتاحة لـ APP_ENV:
#   local      — تطوير محلي سريع
#   staging    — اختبار يشبه Production (يفرض قواعد عزل)
#   production — الإنتاج (يفرض قواعد إنتاج)
#
# ═══════════════════════════════════════════════════════════════

# ── البيئة ──
APP_ENV=local

# ── قاعدة البيانات ──
DATABASE_URL="postgresql://user@localhost:5432/asas_dev"

# ── المصادقة ──
JWT_SECRET="change-me-in-production"

# ── التخزين ──
MEDIA_STORAGE_PATH="./storage"
BACKUP_STORAGE_PATH="./backups"

# ── السيرفر ──
PORT=3000
