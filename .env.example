# ═══════════════════════════════════════════════════════════════
# ⚙️  مثال ملف Environment — لا تضع أسرار حقيقية هنا
# ═══════════════════════════════════════════════════════════════
#
# انسخ هذا الملف إلى .env أو .env.staging وعدّل القيم:
#   cp .env.example .env
#
# القيم المتاحة لـ APP_ENV:
#   local      — تطوير محلي سريع
#   staging    — اختبار يشبه Production (يفرض قواعد عزل)
#   production — الإنتاج (يفرض قواعد إنتاج)
#
# ═══════════════════════════════════════════════════════════════

# ── البيئة ──
APP_ENV=local

# ── تسجيل الطلاب الذاتي ──
# هل التحقق عبر WhatsApp OTP مفعّل في مسار التسجيل الذاتي؟
# القيمة الافتراضية: true (OTP مفعّل) عند غياب هذا المتغير أو أي قيمة غير 'false'
# لتعطيل OTP مؤقتاً (في بيئة التطوير أو عند الطلب): اضبط القيمة على false
# ⚠️  لا تغيّر هذا الإعداد في الإنتاج إلا بموافقة صريحة
STUDENT_REGISTRATION_OTP_ENABLED=true

# ── قاعدة البيانات ──
DATABASE_URL="postgresql://user@localhost:5432/asas_dev"

# ── المصادقة ──
JWT_SECRET="change-me-in-production"

# ── التخزين ──
MEDIA_STORAGE_PATH="./storage"
BACKUP_STORAGE_PATH="./backups"

# ── السيرفر ──
PORT=3000

# 🎬 ميزة الفيديو (VIDEO P4-1) — معطّلة افتراضياً
# عند false (أو غياب المتغير): يُقلع الخادم بلا أي متغير R2_* ولا ffprobe، والصور والصوت تعمل كالمعتاد.
# عند true: يفشل الإقلاع برسالة صريحة إذا نقص أي متغير R2_* أو تعذّر تشغيل ffprobe.
# ⚠️ لا تفعّله في الإنتاج قبل اجتياز بوابة VPS-BENCH-150MB وموافقة المالك.
VIDEO_UPLOAD_ENABLED=false
# الحد الأقصى للفيديو الأصلي بالبايت العشري (افتراضي 150MB) — قابل للرفع إلى 300000000 دون تعديل كود
# MEDIA_VIDEO_MAX_SIZE_BYTES=150000000
# حجم جزء الرفع (افتراضي 1MiB، النطاق 65536..52428800)
# MEDIA_VIDEO_CHUNK_SIZE_BYTES=1048576
# مسار ffprobe/ffmpeg إن لم يكونا ضمن PATH
# MEDIA_FFPROBE_BIN=ffprobe
# MEDIA_FFMPEG_BIN=ffmpeg
# ضبط خيوط ومسبق FFmpeg للعامل (VIDEO PERFORMANCE — القيم الافتراضية معروضة)
# VIDEO_FFMPEG_PRESET=veryfast
# VIDEO_FFMPEG_THREADS=1
# VIDEO_FFMPEG_FILTER_THREADS=1
# VIDEO_FFMPEG_DECODE_THREADS=0
# VIDEO_TRANSCODE_CONCURRENCY=1
# Cloudflare R2 — مطلوبة فقط عند VIDEO_UPLOAD_ENABLED=true (لا تضع قيماً حقيقية هنا)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# دورة الحذف الآمن (VIDEO P4-6) — القيم الافتراضية معروضة
# مهلة الأمان بين الحذف الناعم وجدولة DELETE_OBJECTS (أيام، [1..365])
# MEDIA_DELETE_GRACE_DAYS=30
# مهلة الاحتفاظ بفيديو مرفوع غير مرتبط بأي درس قبل وسمه للحذف (ساعات، [1..720])
# MEDIA_UNLINKED_ASSET_TTL_HOURS=24
# الحد الأقصى لمحاولات DELETE_OBJECTS قبل FAILED (يبقى صف الأصل محفوظاً) [1..50]
# MEDIA_DELETE_MAX_ATTEMPTS=10

# 🔐 نظام الاشتراكات — مفاتيح رموز التفعيل (32 بايت base64): openssl rand -base64 32
# ⚠️ لا تُغيَّر بعد إنشاء رموز. للتدوير أضف V2 مع إبقاء V1.
ACTIVATION_CODE_ENC_KEY_V1=
ACTIVATION_CODE_HMAC_KEY_V1=
