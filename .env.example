# ═══════════════════════════════════════════════════════════════
# ⚙️  مثال ملف Environment — لا تضع أسرار حقيقية هنا
# ═══════════════════════════════════════════════════════════════
#
# انسخ هذا الملف إلى .env أو .env.staging وعدّل القيم:
#   cp .env.example .env
#
# القيم المتاحة لـ APP_ENV:
#   local      — تطوير محلي سريع
#   staging    — اختبار يشبه Production (يفرض قواعد عزل)
#   production — الإنتاج (يفرض قواعد إنتاج)
#
# ═══════════════════════════════════════════════════════════════

# ── البيئة ──
APP_ENV=local

# ── تسجيل الطلاب الذاتي ──
# هل التحقق عبر WhatsApp OTP مفعّل في مسار التسجيل الذاتي؟
# القيمة الافتراضية: true (OTP مفعّل) عند غياب هذا المتغير أو أي قيمة غير 'false'
# لتعطيل OTP مؤقتاً (في بيئة التطوير أو عند الطلب): اضبط القيمة على false
# ⚠️  لا تغيّر هذا الإعداد في الإنتاج إلا بموافقة صريحة
STUDENT_REGISTRATION_OTP_ENABLED=true

# ── قاعدة البيانات ──
DATABASE_URL="postgresql://user@localhost:5432/asas_dev"

# ── المصادقة ──
JWT_SECRET="change-me-in-production"

# ── التخزين ──
MEDIA_STORAGE_PATH="./storage"
BACKUP_STORAGE_PATH="./backups"

# ── السيرفر ──
PORT=3000

# 🔐 نظام الاشتراكات — مفاتيح رموز التفعيل (32 بايت base64): openssl rand -base64 32
# ⚠️ لا تُغيَّر بعد إنشاء رموز. للتدوير أضف V2 مع إبقاء V1.
ACTIVATION_CODE_ENC_KEY_V1=
ACTIVATION_CODE_HMAC_KEY_V1=
